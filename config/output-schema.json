{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyer Short Video Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "input_parameters", "evidence_card", "script", "deliverables", "review_status"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "generated_at", "source_ids"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "generator": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "input_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_objective", "content_type", "duration", "persona"],
      "properties": {
        "primary_objective": {"type": "string", "enum": ["save", "discuss", "share", "explore", "trust"]},
        "content_type": {"type": "string", "enum": ["story", "educational", "comparison", "practical"]},
        "duration": {"type": "string", "enum": ["60s", "90s", "3min"]},
        "persona": {"type": "string", "enum": ["rational", "assertive", "conciliatory"]}
      }
    },
    "evidence_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_facts", "missing_data", "legal_issues_to_verify"],
      "properties": {
        "confirmed_facts": {"type": "array", "items": {"type": "string"}},
        "missing_data": {"type": "array", "items": {"type": "string"}},
        "legal_issues_to_verify": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spoken_script", "subtitle"],
      "properties": {
        "spoken_script": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "title_options": {"type": "array", "items": {"type": "string"}},
        "cta": {"type": ["string", "null"]}
      }
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_prompts", "disclaimers"],
      "properties": {
        "visual_prompts": {"type": "array", "items": {"type": "string"}},
        "disclaimers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "needs_information", "needs_legal_review", "blocked", "ready_for_human_review", "ready_for_publish"]
    }
  }
}
